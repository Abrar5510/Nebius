# Copy to .env. Never commit real keys.

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
# mock  = deterministic local stages, no GPU or credentials (default)
# hybrid = real Nemotron calls on Token Factory (task spec + status lines);
#          GPU stages stay mock until a real phone capture exists
# live  = call every configured NVIDIA / Nebius service
# auto  = hybrid when NEBIUS_API_KEY is set, otherwise mock
SHOWITONCE_MODE=mock
SHOWITONCE_DATA_DIR=.showitonce
SHOWITONCE_DB_URL=sqlite:///.showitonce/showitonce.db

# local  = run stages in this process
# nebius = reserved for the Serverless Job dispatch path (builder in showitonce/nebius.py);
#          automatic dispatch and the live GPU stages are not implemented yet
SHOWITONCE_EXECUTION=local

# ---------------------------------------------------------------------------
# Nebius Token Factory (Nemotron Nano for status lines, Ultra for task specs)
# ---------------------------------------------------------------------------
NEBIUS_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_FAST_MODEL=
NEMOTRON_REASON_MODEL=

# ---------------------------------------------------------------------------
# NVIDIA Cosmos / Parakeet (OpenAI-compatible self-hosted endpoints)
# ---------------------------------------------------------------------------
COSMOS_REASON_URL=
COSMOS_REASON_API_KEY=
PARAKEET_URL=
PARAKEET_API_KEY=

# ---------------------------------------------------------------------------
# Nebius Object Storage (S3-compatible)
# ---------------------------------------------------------------------------
NEBIUS_S3_BUCKET=
NEBIUS_S3_ENDPOINT=https://storage.eu-north1.nebius.cloud
NEBIUS_S3_REGION=eu-north1
NEBIUS_S3_ACCESS_KEY_ID=
NEBIUS_S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Nebius Serverless Jobs
# ---------------------------------------------------------------------------
NEBIUS_CLI=nebius
NEBIUS_PROJECT_ID=
NEBIUS_SUBNET_ID=
SHOWITONCE_JOB_IMAGE=ghcr.io/YOUR-USER/showitonce:latest
SHOWITONCE_JOB_PLATFORM=gpu-l40s-a
SHOWITONCE_JOB_PRESET=1gpu-8vcpu-32gb
